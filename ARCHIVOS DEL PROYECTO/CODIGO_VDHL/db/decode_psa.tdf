--synthesis_resources = lut 8 
SUBDESIGN decode_psa
( 
	data[2..0]	:	input;
	enable	:	input;
	eq[5..0]	:	output;
) 
VARIABLE 
	data_wire[2..0]	: WIRE;
	enable_wire	: WIRE;
	eq_node[5..0]	: WIRE;
	eq_wire[7..0]	: WIRE;
	w_anode655w[3..0]	: WIRE;
	w_anode672w[3..0]	: WIRE;
	w_anode682w[3..0]	: WIRE;
	w_anode692w[3..0]	: WIRE;
	w_anode702w[3..0]	: WIRE;
	w_anode712w[3..0]	: WIRE;
	w_anode722w[3..0]	: WIRE;
	w_anode732w[3..0]	: WIRE;

BEGIN 
	data_wire[] = data[];
	enable_wire = enable;
	eq[] = eq_node[];
	eq_node[5..0] = eq_wire[5..0];
	eq_wire[] = ( w_anode732w[3..3], w_anode722w[3..3], w_anode712w[3..3], w_anode702w[3..3], w_anode692w[3..3], w_anode682w[3..3], w_anode672w[3..3], w_anode655w[3..3]);
	w_anode655w[] = ( (w_anode655w[2..2] & (! data_wire[2..2])), (w_anode655w[1..1] & (! data_wire[1..1])), (w_anode655w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode672w[] = ( (w_anode672w[2..2] & (! data_wire[2..2])), (w_anode672w[1..1] & (! data_wire[1..1])), (w_anode672w[0..0] & data_wire[0..0]), enable_wire);
	w_anode682w[] = ( (w_anode682w[2..2] & (! data_wire[2..2])), (w_anode682w[1..1] & data_wire[1..1]), (w_anode682w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode692w[] = ( (w_anode692w[2..2] & (! data_wire[2..2])), (w_anode692w[1..1] & data_wire[1..1]), (w_anode692w[0..0] & data_wire[0..0]), enable_wire);
	w_anode702w[] = ( (w_anode702w[2..2] & data_wire[2..2]), (w_anode702w[1..1] & (! data_wire[1..1])), (w_anode702w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode712w[] = ( (w_anode712w[2..2] & data_wire[2..2]), (w_anode712w[1..1] & (! data_wire[1..1])), (w_anode712w[0..0] & data_wire[0..0]), enable_wire);
	w_anode722w[] = ( (w_anode722w[2..2] & data_wire[2..2]), (w_anode722w[1..1] & data_wire[1..1]), (w_anode722w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode732w[] = ( (w_anode732w[2..2] & data_wire[2..2]), (w_anode732w[1..1] & data_wire[1..1]), (w_anode732w[0..0] & data_wire[0..0]), enable_wire);
END;
